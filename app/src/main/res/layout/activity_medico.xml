<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:id="@+id/medico"
    android:background="#B9D8E7"
    android:padding="16dp">

    <!-- Header (Topo fixo) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#BFDBFE"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/huocsystem" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="8dp"
            android:text="HUOC - Sistema de Coleta de Dados Clínicos"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Botão de sair com fundo arredondado -->
        <ImageButton
            android:id="@+id/btnLogout"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/rounded_logout_button"
            android:src="@drawable/saida"
            android:scaleType="centerInside"
            android:padding="6dp"
            android:contentDescription="Sair" />
    </LinearLayout>

    <!-- Conteúdo centralizado -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/rounded_white_shadow"
            android:orientation="vertical"
            android:elevation="8dp"
            android:layout_gravity="center"
            android:layout_margin="16dp"
            android:padding="24dp">

            <TextView
                android:id="@+id/titleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="8dp"
                android:text="Bem-vindo à Área Médica"
                android:textColor="#333"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/greetingText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="24dp"
                android:gravity="center"
                android:text="Olá, Usuário! Você está acessando a área de médicos do Sistema HUOC."
                android:textColor="#444"
                android:textSize="16sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="16dp">

                <Button
                    android:id="@+id/btnNewPatients"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:drawableStart="@drawable/ic_new_patient"
                    android:text="Novos"
                    android:backgroundTint="@android:color/holo_green_dark" />

                <Button
                    android:id="@+id/btnFollowUp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:drawableStart="@drawable/ic_follow_up"
                    android:text="Status"
                    android:backgroundTint="@android:color/holo_blue_dark" />

            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Footer (Fixo embaixo) -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#BFDBFE"
        android:gravity="center"
        android:padding="12dp"
        android:text="© 2025 Sistema HUOC. Todos os direitos reservados."
        android:textColor="#444"
        android:textSize="12sp" />
</LinearLayout>
